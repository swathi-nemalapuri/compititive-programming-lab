import java.util.*;

class Solution {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        long a = 1;
        long b = 1;

        for (int i = 2; i <= n; i++) {
            long c = (a + b) % 1000000007;
            a = b;
            b = c;
        }

        System.out.println(b);
    }
}
