import java.io.*;
import java.util.*;
import java.text.*;
import java.math.*;
import java.util.regex.*;

public class Solution {
public static void main(String[] args){
   Scanner obj = new Scanner(System.in);

int n = obj.nextInt();

int[] arr = new int[n];

for (int i = 0; i < n; i++) {
    arr[i] = obj.nextInt();
}

int maxSoFar = arr[0];
int maxend = 0;

for (int i = 0; i < n; i++) {
    maxend += arr[i];

    if (maxend > maxSoFar)
        maxSoFar = maxend;

    if (maxend < 0)
        maxend = 0;
}

System.out.print(maxSoFar);
}}
