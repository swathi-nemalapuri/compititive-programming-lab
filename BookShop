import java.util.*;

class Solution {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int x = sc.nextInt();

        int[] dp = new int[x + 1];

        for (int i = 0; i < n; i++) {
            int price = sc.nextInt();
            int pages = sc.nextInt();

            for (int j = x; j >= price; j--) {
                dp[j] = Math.max(dp[j], dp[j - price] + pages);
            }
        }

        System.out.println(dp[x]);
    }
}
